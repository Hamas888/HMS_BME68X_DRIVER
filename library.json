{
  "name": "HMS_BME68X_DRIVER",
  "version": "1.0.2",
  "description": "This Package Provide BME68X Sensor Driver Library for Cross Platform (ARDUINO/STM/ESP/nRF)",
  "keywords": [
    "BME68X",
    "Sensor",
    "Environmental Sensor",
    "BME680",
    "BME688",
    "Temperature",
    "Humidity",
    "Pressure",
    "Gas",
    "Air Quality",
    "Driver",
    "ESP32",
    "STM32",
    "nRF52",
    "I2C"
  ],
  "authors": [
    {
      "name": "Hamas Saeed",
      "email": "hamasaeed888@gmail.com",
      "url": "https://github.com/Hamas888",
      "maintainer": true
    }
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Hamas888/HMS_BME68X_DRIVER.git"
  },
  "frameworks": ["arduino", "espidf"],
  "platforms": ["espressif32"],
  "build": {
    "flags": [
      "-std=gnu++17"
    ],
    "unflags": [
      "-std=gnu++11"
    ]
  },
  "license": "MIT",
  "homepage": "https://github.com/Hamas888/HMS_BME68X_DRIVER",
  "examples": [
    "examples"
  ],
  "export": {
    "include": [
      "include",
      "src",
      "examples",
      "library.json",
      "LICENSE",
      "README.md"
    ],
    "exclude": [
      "test",
      ".pio",
      ".vscode"
    ]
  }
}